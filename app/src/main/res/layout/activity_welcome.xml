<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The Welcome Image now occupies the WHOLE screen background -->
    <ImageView
        android:id="@+id/ivWelcomeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/welcome_image"
        android:scaleType="centerCrop"
        android:contentDescription="@string/welcome"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Transparent dark overlay to ensure texts and titles are clear and visible over the whole image -->
    <View
        android:id="@+id/vOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Content Container layered perfectly centered over the background image -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Welcome Text Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_learn"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#A5D6A7"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginBottom="20dp"/>

        <!-- Slogan Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/read_spell_grow"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:background="#E8F5E9"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="24dp"/>

        <!-- Description Motto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/motto"
            android:textSize="17sp"
            android:textColor="#E0E0E0"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="56dp"/>

        <!-- Get Started Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/get_started"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="32dp"
            android:textAllCaps="false"
            app:elevation="6dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
