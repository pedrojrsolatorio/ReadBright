<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E8F5E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assessment"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tvGradeInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grade Level"
            android:textSize="20sp"
            android:textColor="#2E7D32"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvQuestionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Question 1 of 5"
            android:textSize="16sp"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instruction"
                android:textSize="17sp"
                android:textStyle="italic"
                android:textColor="#666666"
                android:layout_marginBottom="10dp"/>

            <ImageView
                android:id="@+id/ivQuestionImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerInside"
                android:layout_marginBottom="15dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:visibility="gone"
                android:contentDescription="Question Image" />

            <TextView
                android:id="@+id/tvEmojiFallback"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:gravity="center"
                android:textSize="100sp"
                android:text=""
                android:visibility="gone"
                android:contentDescription="Question Image" />

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#1B5E20"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnMic"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:text="🎤"
                android:textSize="40sp"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvReadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap mic and read"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textColor="#2E7D32"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSpelling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnListen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 Hear Word"
                android:backgroundTint="#1976D2"/>

            <EditText
                android:id="@+id/etSpellingAnswer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Type the spelling here"
                android:gravity="center"
                android:textSize="20sp"
                android:layout_marginTop="15dp"
                android:background="@android:drawable/editbox_background_normal"
                android:inputType="textNoSuggestions"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Check / Next"
            android:textSize="18sp"
            android:backgroundTint="#2E7D32"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Exit Assessment"
            android:backgroundTint="#666666"
            android:layout_marginTop="20dp"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>