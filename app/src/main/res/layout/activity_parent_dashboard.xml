<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E8F5E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parent Dashboard"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvWelcomeParent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Parent"
            android:textSize="20sp"
            android:textColor="#2E7D32"
            android:layout_marginBottom="30dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Child's Progress"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/tvChildName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name: ---"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/tvChildGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grade: ---"
                android:textSize="17sp"
                android:layout_marginTop="5dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/tvChildScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assessment Score: ---"
                android:textSize="17sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvChildSpellingScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spelling Score: ---"
                android:textSize="17sp"
                android:textColor="#F57F17"
                android:layout_marginBottom="15dp"/>

            <!-- Detailed Status -->
            <TextView
                android:id="@+id/tvStatusAlphabet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alphabet: Not Started"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/tvStatusPhonics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phonics: Not Started"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/tvStatusWords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Words: Not Started"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/tvStatusSentences"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sentences: Not Started"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/tvStatusStories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stories: Not Started"
                android:textSize="16sp"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/tvChildStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Stars: ⭐ 0"
                android:textSize="19sp"
                android:textColor="#FBC02D"
                android:textStyle="bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Refresh Progress"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="15dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Logout"
            android:backgroundTint="#666666"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>